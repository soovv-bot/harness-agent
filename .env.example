# ==============================================================================
# SearchHarness / 轨迹蒸馏项目 · 环境变量样例
# 用法：cp .env.example .env，然后填入真实值
# 注意：.env 已在 .gitignore 中忽略，切勿提交真实密钥
# ==============================================================================

# ==============================================================================
# 主模型（OpenAI 兼容端点，如 DeepSeek）【必填】
# ==============================================================================
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 部分脚本走独立别名，二选一或同时配置：
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_BASE=

# ==============================================================================
# 通用模型入口（DeepForge / 部分管线读取 API_KEY + API_BASE）
# ==============================================================================
# API_KEY=
# API_BASE=
# MODEL_NAME=deepseek-chat
# ENTRY_POINT_MODEL=deepseek-chat
# EXPLORATION_MODEL=deepseek-chat
# QA_GENERATION_MODEL=deepseek-chat
# DIFFICULTY_ENHANCEMENT_MODEL=deepseek-chat

# ==============================================================================
# 搜索与抓取【必填】
# ==============================================================================
SERPER_API_KEY=your-serper-api-key          # Google 搜索：https://serper.dev
# SERPER_KEY_ID=                             # SERPER_API_KEY 的旧别名（如旧脚本需要）
JINA_API_KEY=jina_your-jina-key             # 网页内容抓取：https://jina.ai
# JINA_API_KEYS=                             # 多 key 轮询时使用（逗号分隔）
CRAWLER_ENGINE=jina                          # jina | html（html2text 兜底）
# CRAWL_TIMEOUT_S=30
# JINA_TIMEOUT_S=30
# JINA_MAX_FAILURES=3
# WIKI_TIMEOUT_S=20
# WIKI_MAX_TRIES=3
# WIKI_MAX_FAILURES=3

# ==============================================================================
# 评分器（BrowseComp 判分，任何 OpenAI 兼容端点）【评测必填】
# ==============================================================================
GRADER_MODEL=gpt-4o-2024-11-20
GRADER_API_BASE=https://api.openai.com/v1    # 或自建中转端点
GRADER_API_KEY=sk-your-grader-key
# GRADER_MODEL_NAME=                          # GRADER_MODEL 的别名（部分脚本）
# GRADER_OPENAI_API_KEY=
# GRADER_OPENAI_BASE_URL=
# GRADER_REASONING_EFFORT=medium
# GRADER_MAX_TOKENS=
# ANSWER_JUDGE_MODEL=deepseek-chat

# ==============================================================================
# 本地 vLLM 推理端点（可选，离线评测时使用）
# ==============================================================================
# MODEL=deepseek-v3.2
# MODEL_URL=http://127.0.0.1:8000/v1
# MODEL_KEY=sk-your-vllm-key
# MODEL_ID=

# ==============================================================================
# 轨迹蒸馏（batch_generate_trajectories.py）
# ==============================================================================
# DISTILLED_MODEL=deepseek-chat
# DISTILLED_TEMPERATURE=0.6
# DISTILLED_ENABLE_HINT=true
# DISTILLED_MAX_TURNS=30
# DISTILLED_MAX_WORKERS=4
# DISTILLED_QUERY_FILE=source_oriented_data_systhesis/data/mixed_domains_qa_with_enhance.jsonl
# DISTILLED_NUM_SAMPLES=
# DISTILLED_SUMMARY_FILE=data/trajectories/batch_summary.json
# DISTILLED_FORCE=false

# ==============================================================================
# SearchHarness 运行参数（全部可选，不设则用代码默认值）
# ==============================================================================
# PLANNER_TEMPERATURE=
# PLANNER_MAX_TOKENS=
# PLANNER_SIMPLE_PROMPT=false
# EXECUTOR_TEMPERATURE=
# EXECUTOR_MAX_TOKENS=
# EXECUTOR_SIMPLE_PROMPT=false
# EXECUTOR_THINKING=
# EXECUTOR_TOOL_CHOICE=
# EXECUTOR_MODEL_NAME=
# EXECUTOR_MAX_SUBTASK_CONCURRENCY=
# EXECUTOR_SUBTASK_CONCURRENCY=
# EXECUTOR_INFRA_RETRY=
# EXECUTOR_VISIT_URLS_EXCERPT_CHARS=
# VISIT_URLS_RAW_RETURN_MAX_TOKENS=

# 检索内容处理（tools/search_tools.py，值为代码默认值）
# PARAGRAPH_EXTRACT_TOP_K=12               # visit_urls 单次抽取的段落数
# PARAGRAPH_EXTRACT_MAX_CHARS=8000         # 抽取内容的总字符上限
# PARAGRAPH_MIN_LENGTH=40                  # 有效段落最小长度
# SRC_FRESHNESS_MAX_AGE_DAYS=730           # 来源新鲜度窗口（天数）

# ==============================================================================
# 特性开关（可选）
# ==============================================================================
# CRAG_ENABLED=
# REFLEXION_ENABLED=
# VERIFY_RANK_ENABLED=
# PIPELINE_AUTHORITY_EARLY_STOP=
# PIPELINE_AUTHORITY_MIN_SOURCES=
# PIPELINE_FACT_CONFIRM_MIN_SOURCES=

# ==============================================================================
# LLM 缓存 / 超时 / 用量统计（可选）
# ==============================================================================
# LLM_CACHE_MODE=                             # replay 模式用于 M1 复现
# LLM_CACHE_DIR=
# LLM_PRICING_YAML=                           # 默认读 model_pricing.yaml
# LLM_PRICING_JSON=
# LLM_TIMEOUT_S=
# LLM_STREAM_ENABLED=
# LLM_STREAM_TIMEOUT_S=
# LLM_THINKING_BUDGET_TOKENS=
# LLM_STRUCTURER_MAX_TOKENS=
# LLM_STRUCTURER_SKIP_THRESHOLD_CHARS=

# ==============================================================================
# 代码执行工具（tools/）
# ==============================================================================
# CODE_EXEC_BACKEND=subprocess                # subprocess | docker

# ==============================================================================
# 其他（可选）
# ==============================================================================
# LOG_LEVEL=INFO
# IDP_KEY_ID=                                 # 火山引擎 IDP（按需）
# IDP_KEY_SECRET=
# HTTPS_PROXY=                                # 需要代理时启用
# HTTP_PROXY=
