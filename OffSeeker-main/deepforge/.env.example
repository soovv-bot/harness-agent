# DeepForge Environment Variables
#
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit the .env file to version control.
#
# These variables override settings from config.yaml

# ============= API Keys =============
# Serper API key for Google Search
SERPER_API_KEY=""

# OpenAI API key (for OpenAI-compatible endpoints)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# DeepSeek API key
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""

# Jina API key for content extraction
JINA_API_KEY=""

# ============= API Endpoints (Optional) =============
# Override default API endpoints if needed
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============= Internal Gateway (Optional) =============
# Override internal gateway configuration if needed
# GATEWAY_HOST=trpc-gpt-eval.production.polaris
# GATEWAY_PORT=8080
